{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reprorestore.org/schema/manifest/v0.1",
  "title": "ReproRestore Manifest v0.1",
  "type": "object",
  "required": ["project", "resources"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "nix_configuration": {"type": "string"}
      },
      "additionalProperties": true
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "capture_hook": {"type": "string"},
          "restore_hook": {"type": "string"},
          "validation_probe": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
